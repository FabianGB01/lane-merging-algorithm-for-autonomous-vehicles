ac1d: ac1d.cc
	g++ -O3  -o ac1d -I../Include ac1d.cc -L../Lib -L/usr/X11R6/lib -lMisc -lGI -lX11

spin: spin.cc
	g++ -O3  -o spin -I../Include spin.cc -L../Lib -L/usr/X11R6/lib -lMisc -lGI -lX11

parity: parity.cc
	g++ -O3 -o parity -I../Include parity.cc -L../Lib -L/usr/X11R6/lib -lMisc -lGI -lX11

plotExple: plotExple.cc
	g++ -O3  -o plotExple -I../Include plotExple.cc -L../Lib -L/usr/X11R6/lib  -lGI -lMisc -lX11

clean:
	rm ac1d parity  plotExple spin